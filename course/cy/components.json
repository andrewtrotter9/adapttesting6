    "title": "Cwestiwn 3",
    "displayTitle": "Cwestiwn 3",
    "body": "<p><span style=\"color:hsl(0,0%,0%);\">Pa mor hyderus ydych chi’n teimlo wrth gymryd camau, gan gynnwys cyfeirio neu atgyfeirio, os yw cwsmer wedi benthyg gan fenthyciwr anghyfreithlon?</span></p>",
    "_onScreen": {
      "_isEnabled": false,
      "_classes": "",
      "_percentInviewVertical": 50,
      "_animationName": "",
      "_animationDelay": "delay-0.5s",
      "_animationRepetition": "repeat-1",
      "_animationSpeed": "slow"
    },
    "_tutor": {
      "_isInherited": true,
      "_type": "notify",
      "_classes": "",
      "_hasNotifyBottomButton": false,
      "_button": {
        "text": "{{_globals._extensions._tutor.hideFeedback}}",
