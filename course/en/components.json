    "title": "Question 4",
    "displayTitle": "Question 4",
    "body": "<p><span style=\"color:hsl(0,0%,0%);\">How confident do you feel about having supportive, non-judgemental conversations with customers affected by illegal lending?</span></p>",
    "_onScreen": {
      "_isEnabled": false,
      "_classes": "",
      "_percentInviewVertical": 50,
      "_animationName": "",
      "_animationDelay": "delay-0.5s",
      "_animationRepetition": "repeat-1",
