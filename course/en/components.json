    "title": "Question 3",
    "displayTitle": "Question 3",
    "body": "<p><span style=\"color:hsl(0,0%,0%);\">How confident do you feel in taking action, including signposting or referral, if a customer has borrowed from an illegal lender?</span></p>",
    "_onScreen": {
      "_isEnabled": false,
      "_classes": "",
      "_percentInviewVertical": 50,
      "_animationName": "",
      "_animationDelay": "delay-0.5s",
