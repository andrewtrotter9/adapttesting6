    "title": "Question 1",
    "displayTitle": "Question 1",
    "body": "<p><span style=\"color:hsl(0,0%,0%);\">How confident do you feel about your awareness of what illegal lending involves?</span></p>",
    "_onScreen": {
      "_isEnabled": false,
      "_classes": "",
      "_percentInviewVertical": 50,
      "_animationName": "",
      "_animationDelay": "delay-0.5s",
      "_animationRepetition": "repeat-1",
      "_animationSpeed": "slow"
