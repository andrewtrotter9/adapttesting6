    "ariaQuestion": "",
    "disabledBody": "",
    "_attempts": 1,
    "_shouldDisplayAttempts": false,
    "_canShowFeedback": true,
    "_canShowMarking": false,
    "_questionWeight": 1,
    "_recordInteraction": true,
    "_shouldStoreResponses": false,
    "_linkedToId": "",
    "ariaScaleName": "confidence",
    "labelStart": "",
    "labelEnd": "",
    "_scaleStart": 1,
    "_scaleEnd": 5,
