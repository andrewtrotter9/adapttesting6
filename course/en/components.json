    "_tutor": {
      "_isInherited": true,
      "_type": "notify",
      "_classes": "",
      "_hasNotifyBottomButton": false,
      "_button": {
        "text": "{{_globals._extensions._tutor.hideFeedback}}",
        "ariaLabel": "{{_globals._extensions._tutor.hideFeedback}}"
