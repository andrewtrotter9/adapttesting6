    "title": "Question 2",
    "displayTitle": "Question 2",
    "body": "<p><span style=\"color:hsl(0,0%,0%);\">How confident do you feel about spotting the red flags that your customer may have borrowed from an illegal lender?</span></p>",
    "_onScreen": {
      "_isEnabled": false,
      "_classes": "",
      "_percentInviewVertical": 50,
      "_animationName": "",
      "_animationDelay": "delay-0.5s",
      "_animationRepetition": "repeat-1",
