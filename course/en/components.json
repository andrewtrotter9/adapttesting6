    "labelStart": "",
    "labelEnd": "",
    "_scaleStart": 1,
    "_scaleEnd": 5,
    "_scaleStep": 1,
    "_showNumber": true,
    "_showScaleIndicator": true,
    "_showScale": true,
    "_feedback": {
      "title": "",
